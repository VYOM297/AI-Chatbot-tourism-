

# ---------- Custom action server (actions.py) ----------
FROM rasa/rasa-sdk:3.6.2

WORKDIR /app
USER root
RUN pip install --no-cache-dir requests

COPY actions /app/actions
# actions.py looks for ../data/eco_hotels.json relative to itself
COPY data/eco_hotels.json /app/data/eco_hotels.json

USER 1001
EXPOSE 5055
CMD ["start", "--actions", "actions"]